# Gere valores fortes antes da primeira execução e salve-os em um arquivo .env local.
# Este arquivo é da produção. Para testes isolados, use scripts/start-dev.ps1 (.env.dev).
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica
APP_SESSION_SECRET=troque-por-um-segredo-longo-e-unico
OPENWA_MASTER_KEY=troque-por-uma-chave-de-administrador-longa
DISCORD_UNASSIGNED_WEBHOOK_URL=
# Ponte recomendada para Google Sheets privado (opcional; veja docs/AUTOMACOES.md).
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Alternativa legada: JSON da conta de serviço codificado em Base64. Nunca publique esse valor.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
